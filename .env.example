# PolicyWatch configuration — LOCAL DEVELOPMENT EXAMPLE.
# Copy to .env (`cp .env.example .env`). The values below are throwaway development values; never reuse
# them anywhere reachable from the internet. Generate real secrets with:
#   API keys:              openssl rand -base64 36 | tr -d '/+=' | cut -c1-48
#   SECRET_ENCRYPTION_KEY: openssl rand -base64 32
# For AWS, secrets live in SSM Parameter Store instead (see docs/deployment-aws.md).

NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false

# --- Datastores -----------------------------------------------------------------------------------
# Docker Compose overrides the hosts to `postgres`/`redis`; these values suit running Node on the host.
POSTGRES_PASSWORD=policywatch-dev-only
DATABASE_URL=postgresql://policywatch:policywatch-dev-only@127.0.0.1:5432/policywatch?schema=public
REDIS_URL=redis://127.0.0.1:6379
QUEUE_PREFIX=policywatch

# --- API authentication (bearer keys, >= 32 chars) -----------------------------------------------
ADMIN_API_KEY=pw_dev_admin_7Hq2vX9mK4tR8wN3pL6sB1cF5jD0gZ
READONLY_API_KEY=pw_dev_read_3Kd8sW1qT6yH9mB4nV7xC2fJ5gL0rP

# --- Encryption of webhook signing secrets at rest (32 bytes, base64) -------------------------------
SECRET_ENCRYPTION_KEY=ZGV2LW9ubHktZW5jcnlwdGlvbi1rZXktMzItYnl0ZXM=

# --- Carrier simulator (synthetic carriers; both the app and the simulator read these) -------------
CARRIER_SIM_BASE_URL=http://127.0.0.1:4000
CARRIER_ACME_API_KEY=sim-acme-api-key
CARRIER_BLUEBIRD_TOKEN=sim-bluebird-token
CARRIER_CARDINAL_USERNAME=policywatch
CARRIER_CARDINAL_PASSWORD=sim-cardinal-password
CARRIER_TIMEOUT_MS=5000

# --- Monitoring ------------------------------------------------------------------------------------
DEFAULT_CHECK_INTERVAL_SECONDS=3600
MIN_CHECK_INTERVAL_SECONDS=60
CHECK_FAILURE_BACKOFF_BASE_SECONDS=30
SCHEDULER_TICK_MS=5000

# --- Webhooks --------------------------------------------------------------------------------------
WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=8
# Short base delay so the demo shows several retries within a minute. Production: 30000 or more.
WEBHOOK_BACKOFF_BASE_MS=2000
WEBHOOK_BACKOFF_MAX_MS=900000
# Development only: lets webhooks reach the local mock receiver over plain HTTP on a private address.
# Leave EMPTY in any shared or cloud environment — it bypasses SSRF protection for these hosts.
WEBHOOK_ALLOWED_HOSTS=127.0.0.1,localhost,mock-receiver
WEBHOOK_REQUIRE_HTTPS=false

# --- Demo script -----------------------------------------------------------------------------------
API_URL=http://127.0.0.1:3000
CARRIER_SIM_URL=http://127.0.0.1:4000
RECEIVER_URL=http://127.0.0.1:4100
# The URL PolicyWatch should POST to (as seen from the worker). Compose sets http://mock-receiver:4100/webhooks
RECEIVER_WEBHOOK_URL=http://127.0.0.1:4100/webhooks
