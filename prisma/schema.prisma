// PolicyWatch persistence model.
// Table/column names are snake_case in PostgreSQL; see docs/database.md for the rationale behind each table.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PolicyStatus {
  ACTIVE
  PENDING
  CANCELLED
  EXPIRED
}

enum CheckTrigger {
  ENROLLMENT
  SCHEDULED
  MANUAL
}

enum CheckOutcome {
  BASELINE // first successful retrieval; establishes version 1, emits no events
  CHANGED // content changed; new snapshot written (may emit zero or more events)
  UNCHANGED // content hash identical to the current snapshot
  STALE_DISCARDED // response older than the current snapshot (lost a race); ignored
  FAILED // carrier data could not be obtained or trusted; policy state untouched
}

enum FailureCategory {
  CARRIER_TIMEOUT
  CARRIER_UNAVAILABLE
  CARRIER_RATE_LIMITED
  CARRIER_AUTH_FAILED
  CARRIER_REQUEST_REJECTED
  CARRIER_DATA_UNAVAILABLE
  POLICY_NOT_FOUND
  INVALID_CARRIER_RESPONSE
  INTERNAL_ERROR
}

enum EventType {
  POLICY_CANCELLED
  POLICY_REINSTATED
  POLICY_RENEWED
  POLICY_EXPIRED
  COVERAGE_CHANGED
  PREMIUM_CHANGED
  VEHICLE_ADDED
  VEHICLE_REMOVED
}

enum OutboxStatus {
  PENDING
  PROCESSED
}

enum SubscriptionStatus {
  ACTIVE
  INACTIVE
  DELETED
}

enum DeliveryStatus {
  PENDING
  IN_PROGRESS
  RETRY_SCHEDULED
  SUCCEEDED
  FAILED
  CANCELLED
}

enum AttemptOutcome {
  SUCCESS
  HTTP_ERROR
  TIMEOUT
  NETWORK_ERROR
  BLOCKED_DESTINATION
}

enum DeliveryTrigger {
  AUTOMATIC
  MANUAL
}

/// A carrier policy enrolled for monitoring. Denormalized "current" columns mirror the latest snapshot
/// so list/filter queries never need to unpack JSON.
model Policy {
  id                    String           @id
  carrierId             String           @map("carrier_id")
  externalPolicyId      String           @map("external_policy_id")
  status                PolicyStatus?
  policyType            String?          @map("policy_type")
  effectiveDate         DateTime?        @map("effective_date") @db.Date
  expirationDate        DateTime?        @map("expiration_date") @db.Date
  premiumCents          Int?             @map("premium_cents")
  premiumCurrency       String?          @map("premium_currency") @db.Char(3)
  currentVersion        Int              @default(0) @map("current_version")
  monitoringEnabled     Boolean          @default(true) @map("monitoring_enabled")
  checkIntervalSeconds  Int              @map("check_interval_seconds")
  nextCheckAt           DateTime         @map("next_check_at") @db.Timestamptz(3)
  lastCheckedAt         DateTime?        @map("last_checked_at") @db.Timestamptz(3)
  lastSuccessfulCheckAt DateTime?        @map("last_successful_check_at") @db.Timestamptz(3)
  lastCheckOutcome      CheckOutcome?    @map("last_check_outcome")
  lastFailureCategory   FailureCategory? @map("last_failure_category")
  consecutiveFailures   Int              @default(0) @map("consecutive_failures")
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  snapshots PolicySnapshot[]
  checks    PolicyCheck[]
  events    PolicyEvent[]

  @@unique([carrierId, externalPolicyId])
  @@index([monitoringEnabled, nextCheckAt])
  @@index([carrierId, id])
  @@index([status, id])
  @@map("policies")
}

/// Append-only, versioned copy of the NormalizedPolicy v1 document. A new version is written only when
/// the canonical content hash changes.
model PolicySnapshot {
  id          String   @id
  policyId    String   @map("policy_id")
  version     Int
  contentHash String   @map("content_hash") @db.Char(64)
  data        Json
  retrievedAt DateTime @map("retrieved_at") @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@unique([policyId, version])
  @@map("policy_snapshots")
}

/// Audit record of every monitoring attempt, successful or not.
model PolicyCheck {
  id              String           @id
  policyId        String           @map("policy_id")
  trigger         CheckTrigger
  outcome         CheckOutcome
  failureCategory FailureCategory? @map("failure_category")
  errorMessage    String?          @map("error_message")
  httpStatus      Int?             @map("http_status")
  snapshotVersion Int?             @map("snapshot_version")
  eventsGenerated Int              @default(0) @map("events_generated")
  durationMs      Int              @map("duration_ms")
  correlationId   String?          @map("correlation_id")
  startedAt       DateTime         @map("started_at") @db.Timestamptz(3)
  completedAt     DateTime         @map("completed_at") @db.Timestamptz(3)

  policy Policy @relation(fields: [policyId], references: [id], onDelete: Cascade)

  @@index([policyId, id])
  @@map("policy_checks")
}

/// Immutable domain event. `dedupeKey` makes event generation idempotent:
/// "<policyId>:v<snapshotVersion>:<eventType>:<discriminator>".
model PolicyEvent {
  id               String    @id
  policyId         String    @map("policy_id")
  carrierId        String    @map("carrier_id")
  externalPolicyId String    @map("external_policy_id")
  eventType        EventType @map("event_type")
  schemaVersion    String    @map("schema_version")
  policyVersion    Int       @map("policy_version")
  previousVersion  Int       @map("previous_version")
  dedupeKey        String    @unique @map("dedupe_key")
  data             Json
  occurredAt       DateTime  @map("occurred_at") @db.Timestamptz(3)
  correlationId    String?   @map("correlation_id")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  policy     Policy            @relation(fields: [policyId], references: [id], onDelete: Cascade)
  outbox     OutboxMessage?
  deliveries WebhookDelivery[]

  @@index([policyId, id])
  @@index([eventType, id])
  @@index([carrierId, id])
  @@map("policy_events")
}

/// Transactional outbox: written in the same transaction as the event, drained by the relay.
model OutboxMessage {
  id          String       @id
  eventId     String       @unique @map("event_id")
  topic       String
  status      OutboxStatus @default(PENDING)
  attempts    Int          @default(0)
  availableAt DateTime     @default(now()) @map("available_at") @db.Timestamptz(3)
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastError   String?      @map("last_error")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  event PolicyEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([status, availableAt])
  @@map("outbox_messages")
}

model WebhookSubscription {
  id               String             @id
  url              String
  description      String?
  /// Event types to deliver; ["*"] means all event types.
  eventTypes       String[]           @map("event_types")
  /// Optional carrier filter; empty means all carriers.
  carrierIds       String[]           @map("carrier_ids")
  status           SubscriptionStatus @default(ACTIVE)
  /// AES-256-GCM ciphertext of the signing secret (never stored or logged in plaintext).
  secretCiphertext String             @map("secret_ciphertext")
  secretHint       String             @map("secret_hint")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  deliveries WebhookDelivery[]

  @@index([status])
  @@map("webhook_subscriptions")
}

/// One logical delivery of one event to one subscription. Unique per (subscription, event) so outbox
/// re-processing can never fan out the same event twice.
model WebhookDelivery {
  id                 String         @id
  subscriptionId     String         @map("subscription_id")
  eventId            String         @map("event_id")
  status             DeliveryStatus @default(PENDING)
  attemptCount       Int            @default(0) @map("attempt_count")
  maxAttempts        Int            @map("max_attempts")
  manualRetryCount   Int            @default(0) @map("manual_retry_count")
  nextAttemptAt      DateTime       @default(now()) @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil        DateTime?      @map("locked_until") @db.Timestamptz(3)
  enqueuedAt         DateTime?      @map("enqueued_at") @db.Timestamptz(3)
  lastAttemptAt      DateTime?      @map("last_attempt_at") @db.Timestamptz(3)
  lastResponseStatus Int?           @map("last_response_status")
  lastError          String?        @map("last_error")
  succeededAt        DateTime?      @map("succeeded_at") @db.Timestamptz(3)
  failedAt           DateTime?      @map("failed_at") @db.Timestamptz(3)
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  subscription WebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  event        PolicyEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  attempts     DeliveryAttempt[]

  @@unique([subscriptionId, eventId])
  @@index([status, nextAttemptAt])
  @@index([eventId])
  @@index([subscriptionId, id])
  @@map("webhook_deliveries")
}

/// Every HTTP attempt, kept for the delivery audit trail.
model DeliveryAttempt {
  id                  String          @id
  deliveryId          String          @map("delivery_id")
  attemptNumber       Int             @map("attempt_number")
  trigger             DeliveryTrigger
  outcome             AttemptOutcome
  destinationHost     String          @map("destination_host")
  responseStatus      Int?            @map("response_status")
  responseBodySnippet String?         @map("response_body_snippet")
  errorMessage        String?         @map("error_message")
  signatureTimestamp  Int             @map("signature_timestamp")
  durationMs          Int             @map("duration_ms")
  startedAt           DateTime        @map("started_at") @db.Timestamptz(3)
  completedAt         DateTime        @map("completed_at") @db.Timestamptz(3)

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}
