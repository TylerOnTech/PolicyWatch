# Remote state for team use. Create the bucket once (versioning + default encryption + public access
# block), then copy this file to backend.tf and run `terraform init -migrate-state`.
terraform {
  backend "s3" {
    bucket       = "REPLACE-ME-policywatch-tfstate"
    key          = "policywatch/demo/terraform.tfstate"
    region       = "us-east-1"
    encrypt      = true
    use_lockfile = true # S3-native state locking (Terraform >= 1.10); no DynamoDB table needed
  }
}
