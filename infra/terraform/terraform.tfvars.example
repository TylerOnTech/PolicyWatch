# Copy to terraform.tfvars (gitignored) and adjust. No credentials or secrets belong in this file.

aws_region  = "us-east-1"
project     = "policywatch"
environment = "demo"

# Who may reach the API on 80/443. Your own IP keeps the demo private:  curl -s https://checkip.amazonaws.com
api_ingress_cidrs = ["203.0.113.7/32"]

# Ansible connects over SSH from these addresses only. Leave empty to keep port 22 closed.
ssh_ingress_cidrs = ["203.0.113.7/32"]
ssh_public_key    = "ssh-ed25519 AAAA... you@laptop"

instance_type       = "t4g.small"
root_volume_size_gb = 20
log_retention_days  = 14

enable_alarms          = true
alarm_email            = ""
enable_daily_snapshots = true

# Optional: a DNS name you will point at the Elastic IP (Caddy then serves HTTPS automatically).
domain_name = ""
