# Managed by Ansible — do not edit on the host. Secrets come from SSM {{ ssm_parameter_prefix }}.
NODE_ENV=production
SERVICE_VERSION={{ policywatch_version }}
APP_VERSION={{ policywatch_version }}
LOG_LEVEL={{ policywatch_log_level }}

AWS_REGION={{ aws_region }}
CLOUDWATCH_LOG_GROUP={{ cloudwatch_log_group }}
SITE_ADDRESS={{ site_address | default(':80') }}

ADMIN_API_KEY={{ policywatch_secrets.ADMIN_API_KEY }}
READONLY_API_KEY={{ policywatch_secrets.READONLY_API_KEY }}
SECRET_ENCRYPTION_KEY={{ policywatch_secrets.SECRET_ENCRYPTION_KEY }}
POSTGRES_PASSWORD={{ policywatch_secrets.POSTGRES_PASSWORD }}
REDIS_PASSWORD={{ policywatch_secrets.REDIS_PASSWORD }}

DEFAULT_CHECK_INTERVAL_SECONDS={{ policywatch_default_check_interval_seconds }}
WEBHOOK_MAX_ATTEMPTS={{ policywatch_webhook_max_attempts }}
WEBHOOK_BACKOFF_BASE_MS={{ policywatch_webhook_backoff_base_ms }}
WEBHOOK_REQUIRE_HTTPS=true
WEBHOOK_ALLOWED_HOSTS={{ policywatch_webhook_allowed_hosts }}
