{
  "name": "policywatch",
  "version": "1.0.0",
  "description": "Event-driven insurance policy monitoring with reliable, signed webhook delivery.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test",
    "dev": "tsx scripts/dev.ts",
    "dev:api": "tsx watch --env-file-if-exists=.env src/entrypoints/api.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/entrypoints/worker.ts",
    "dev:carriers": "tsx watch --env-file-if-exists=.env src/entrypoints/carrier-sim.ts",
    "dev:receiver": "tsx watch --env-file-if-exists=.env src/entrypoints/mock-receiver.ts",
    "start:api": "node dist/entrypoints/api.js",
    "start:worker": "node dist/entrypoints/worker.js",
    "start:carriers": "node dist/entrypoints/carrier-sim.js",
    "start:receiver": "node dist/entrypoints/mock-receiver.js",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx --env-file-if-exists=.env scripts/seed.ts",
    "demo": "tsx --env-file-if-exists=.env scripts/demo.ts",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bullmq": "^5.81.5",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.0",
    "ioredis": "^5.11.1",
    "pino": "^9.14.0",
    "pino-http": "^10.5.0",
    "prom-client": "^15.1.3",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.8.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.3",
    "@types/node": "^22.20.5",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.0.0",
    "prisma": "6.19.3",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "4.1.12"
  },
  "overrides": {
    "deepmerge-ts": "^8.0.2"
  }
}
